PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3308
DB_USER=root
DB_PASSWORD=
DB_NAME=library_db
# Homebrew MySQL on the default port: DB_PORT=3306 and set DB_PASSWORD.
# Hosted MySQL (Railway/Render): set MYSQL_URL instead of the DB_* variables.
# MYSQL_URL=mysql://user:password@host:3306/library_db
# DB_SSL=true

